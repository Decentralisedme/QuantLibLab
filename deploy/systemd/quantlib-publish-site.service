[Unit]
Description=Rebuild site/curves.json and push to origin/main for Netlify
After=network-online.target
OnFailure=quantlib-publish-site-alert.service

[Service]
Type=oneshot
User=groku
Group=groku
WorkingDirectory=/home/groku/QuantLibLab
ExecStart=/home/groku/QuantLibLab/scripts/publish_site.sh
StandardOutput=append:/home/groku/QuantLibLab/data/logs/publish_site.log
StandardError=append:/home/groku/QuantLibLab/data/logs/publish_site.log
TimeoutStartSec=300
