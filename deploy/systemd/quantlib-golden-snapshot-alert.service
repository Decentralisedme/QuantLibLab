[Unit]
Description=Send Telegram alert for a failed quantlib-golden-snapshot run
After=network-online.target

[Service]
Type=oneshot
User=groku
Group=groku
Environment=SERVICE_LABEL=quantlib-golden-snapshot.service
Environment=LOG_FILE=/home/groku/QuantLibLab/data/logs/golden_snapshot.log
EnvironmentFile=-/etc/quantlib-harness/telegram.env
ExecStart=/home/groku/QuantLibLab/scripts/telegram_alert.sh
